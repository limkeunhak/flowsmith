      }
    },
    {
      "id": "e5",
      "from": {
        "node": "searchEmpty",
        "port": "out"
      },
      "to": {
        "node": "empty"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "empty",
        "port": "out"
      },
      "to": {
        "node": "judge"
      }
    }
  ]
}
