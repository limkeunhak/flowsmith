    {
      "id": "seed",
      "type": "custom",
      "name": "캐릭터 · 소유자 찾기",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "code": "const base = \"https://qa.msu.io\"; const open = async (u) => { await page.goto(new URL(u, base).href, { waitUntil: 'domcontentloaded' }); await page.waitForTimeout(4000); };\nconst hrefs = async (k) => [...new Set(await page.locator(`a[href*=\"/navigator/${k}/\"]`).evaluateAll((as) => as.map((a) => a.getAttribute('href'))))];\nawait open(\"https://qa.msu.io/navigator\");\nawait page.locator('a[href*=\"/navigator/nft/\"]').first().waitFor({ state: 'attached', timeout: 30000 });\nconst items = await hrefs('nft'); const seen = [];\nfor (const it of items.slice(0, 5)) {\n  await open(it);\n  const o = await page.locator('a[href*=\"/navigator/owner/\"]').first().getAttribute('href', { timeout: 15000 }).catch(() => null);\n  if (!o || seen.includes(o)) continue; seen.push(o);\n  await open(o);\n  await page.locator('a[href*=\"/navigator/character/\"]').first().waitFor({ state: 'attached', timeout: 15000 }).catch(() => {});\n  const chars = await hrefs('character'); if (!chars.length) continue;\n  return { character: chars[0].split('/navigator/character/')[1], characterUrl: new URL(chars[0], base).href, owner: o.split('/navigator/owner/')[1], ownerUrl: new URL(o, base).href };\n}\nthrow new Error('랭킹 아이템 ' + items.length + '개의 소유자(' + seen.length + '명) 중 캐릭터를 가진 지갑이 없습니다');",
        "outputs": [
          "character",
          "characterUrl",
          "owner",
          "ownerUrl"
        ],
        "usesPage": true,
        "timeoutMs": 180000
      }
    },
