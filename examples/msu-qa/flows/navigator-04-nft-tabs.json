{
  "schemaVersion": 1,
  "id": "navigator-04-nft-tabs",
  "name": "Navigator · NFT 상세 탭 전환",
  "description": "04-detail-pages: 랭킹 아이템의 NFT 상세가 열리고 기본 Info에서 History로 전환된다",
  "params": [],
  "vars": {},
  "secrets": [],
  "settings": {
    "defaultTimeoutMs": 20000,
    "forbiddenLabels": []
  },
  "nodes": [
    {
      "id": "find",
      "type": "web",
      "name": "랜딩에서 랭킹 아이템 고르기",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/navigator"
        },
        "actions": [
          {
            "id": "a575",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 5000
            }
          },
          {
            "id": "a576",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a577",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "첫 nft 링크",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//a[contains(@href,\"/navigator/nft/\")])[1]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "nft",
            "strategy": "link",
            "attribute": null,
            "transform": null
          }
        ]
      }
    },
    {
      "id": "nft",
      "type": "web",
      "name": "NFT 상세 · History 누르기",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "{{ $node.find.nft }}"
        },
        "actions": [
          {
            "id": "a578",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
