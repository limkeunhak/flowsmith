    {
      "id": "where",
      "type": "custom",
      "name": "지금 주소",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "code": "return { path: new URL(page.url()).pathname, url: decodeURIComponent(page.url()), title: await page.title() };",
        "outputs": [
          "path",
          "url",
          "title"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
    {
      "id": "judge",
      "type": "check",
      "name": "판정",
      "position": {
        "x": 900,
        "y": 0
      },
      "config": {
        "items": [
          {
            "id": "k588",
            "label": "제목에 «| MSU Navigator»",
            "actual": "{{ $input.title }}",
            "op": "contains",
            "expected": "| MSU Navigator"
          },
          {
            "id": "k589",
            "label": "기본 탭은 Info — Info 선택",
            "actual": "{{ $node.nft.bInfo }}",
            "op": "eq",
            "expected": "true"
          },
          {
            "id": "k590",
            "label": "History 누른 뒤 — History 선택",
            "actual": "{{ $node.nft.aHistory }}",
            "op": "eq",
            "expected": "true"
          },
          {
            "id": "k591",
            "label": "History 누른 뒤 — 앞 탭 Info는 선택 아님",
            "actual": "{{ $node.nft.aInfo }}",
            "op": "ne",
            "expected": "true"
          }
        ]
      }
    }
