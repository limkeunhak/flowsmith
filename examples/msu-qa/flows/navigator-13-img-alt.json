    {
      "id": "judge",
      "type": "check",
      "name": "판정",
      "position": {
        "x": 1800,
        "y": 0
      },
      "config": {
        "items": [
          {
            "id": "k957",
            "label": "랜딩: alt 속성이 없는 이미지가 있으면 안 된다",
            "actual": "{{ $node.altLanding.missing }}",
            "op": "empty",
            "expected": null
          },
          {
            "id": "k958",
            "label": "아이템 상세: alt 속성이 없는 이미지가 있으면 안 된다",
