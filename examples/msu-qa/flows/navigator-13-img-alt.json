            }
          },
          {
            "id": "a954",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          }
        ]
      }
    },
    {
      "id": "altNft",
      "type": "custom",
      "name": "아이템 상세 alt 누락",
      "position": {
        "x": 900,
        "y": 0
      },
      "config": {
        "code": "await page.waitForLoadState('networkidle', { timeout: 3000 }).catch(() => {});\nconst missing = await page.evaluate(() => Array.from(document.querySelectorAll('img')).filter((i) => !!i.offsetParent).filter((i) => i.getAttribute('alt') === null).map((i) => (i.getAttribute('src') || '').split('?')[0].slice(-50)));\nreturn { missing: missing.join(', ') };",
