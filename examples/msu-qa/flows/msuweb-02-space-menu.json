      "name": "MSU Space 에 마우스 올리기",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "code": "const t = page.locator('header a[data-link=\"gnb-link\"]', { hasText: 'MSU Space' }).first();\nawait t.waitFor({ state: 'visible', timeout: 20000 }); await t.hover();\nawait page.locator('[role=\"listbox\"]').first().waitFor({ state: 'visible', timeout: 15000 }).catch(() => {});\nawait page.waitForTimeout(600);\nreturn { options: await page.locator('[role=\"option\"]').count() };",
        "outputs": [
          "options"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
