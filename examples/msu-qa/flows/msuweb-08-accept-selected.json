{
  "schemaVersion": 1,
  "id": "msuweb-08-accept-selected",
  "name": "MSU 웹 · 쿠키 설정에서 고른 항목만",
  "description": "08-cookie-consent: Accept Selected로 설정 창을 열어 세 번째 칸(Statistics)만 켜고 Confirm My Choices",
  "params": [],
  "vars": {},
  "secrets": [],
  "settings": {
    "defaultTimeoutMs": 20000,
    "forbiddenLabels": []
  },
  "nodes": [
    {
      "id": "open",
      "type": "web",
      "name": "첫 방문",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/"
        },
        "actions": [
          {
            "id": "a304",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 4000
            }
          },
          {
            "id": "a302",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "배너 «Accept Selected»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:visible:has-text(\"Accept Selected\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a303",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "«Cookie Settings»",
              "locators": [
                {
                  "kind": "text",
                  "value": "Cookie Settings"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "settings",
            "strategy": "innerText",
            "attribute": null,
            "transform": null
          }
        ]
      }
    },
    {
      "id": "boxes",
      "type": "custom",
      "name": "설정 창 체크박스 수",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "code": "return { boxes: await page.locator('#cookiebotModal input[type=checkbox]').count() };",
        "outputs": [
          "boxes"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
    {
      "id": "choose",
      "type": "web",
      "name": "세 번째 칸 켜고 확인",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "continue"
        },
        "actions": [
          {
            "id": "wb1",
            "kind": "check",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "설정 창 세 번째 체크박스",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//*[@id='cookiebotModal']//input[@type='checkbox'])[3]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "checked": true
          },
          {
            "id": "a305",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "«Confirm My Choices»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:visible:has-text(\"Confirm My Choices\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a306",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 2500
            }
          },
          {
            "id": "a307",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 배너",
              "locators": [
                {
                  "kind": "css",
                  "value": "#cookiebotBanner"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "banner",
            "strategy": "innerText",
            "attribute": null,
            "transform": null
          }
        ]
      }
    },
    {
      "id": "consent",
      "type": "custom",
      "name": "기록된 쿠키 동의",
      "position": {
        "x": 900,
        "y": 0
      },
      "config": {
        "code": "const raw = (await page.context().cookies()).find((c) => c.name === 'CookieConsent')?.value ?? '';\nconst text = decodeURIComponent(raw);\nconst v = (k) => { const m = text.match(new RegExp(k + ':(true|false)')); return m ? m[1] : ''; };\nconst consent = { recorded: raw !== '', raw: text, necessary: v('necessary'), preferences: v('preferences'), statistics: v('statistics'), marketing: v('marketing') };\nreturn consent;",
        "outputs": [
          "recorded",
          "raw",
          "necessary",
          "preferences",
          "statistics",
          "marketing"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
    {
      "id": "judge",
      "type": "check",
      "name": "판정",
      "position": {
        "x": 1200,
        "y": 0
      },
      "config": {
        "items": [
          {
            "id": "k308",
            "label": "설정 창이 열려야 한다",
            "actual": "{{ $node.open.settings }}",
            "op": "notEmpty",
            "expected": null
          },
          {
            "id": "k309",
            "label": "다섯 개 항목이 있어야 한다",
            "actual": "{{ $node.boxes.boxes }}",
            "op": "eq",
            "expected": "5"
          },
          {
            "id": "k310",
            "label": "선택이 기록되어야 한다",
            "actual": "{{ $input.recorded }}",
            "op": "isTrue",
            "expected": null
          },
          {
            "id": "k311",
            "label": "고른 항목은 동의여야 한다(statistics)",
            "actual": "{{ $input.statistics }}",
            "op": "isTrue",
            "expected": null
          },
          {
            "id": "k312",
            "label": "고르지 않은 항목은 거부여야 한다(preferences)",
            "actual": "{{ $input.preferences }}",
            "op": "isFalse",
            "expected": null
          },
          {
            "id": "k313",
            "label": "고르지 않은 항목은 거부여야 한다(marketing)",
            "actual": "{{ $input.marketing }}",
            "op": "isFalse",
            "expected": null
          },
          {
            "id": "k314",
            "label": "확인 후 배너가 닫혀야 한다",
            "actual": "{{ $node.choose.banner }}",
            "op": "empty",
            "expected": null
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "open",
        "port": "out"
      },
      "to": {
        "node": "boxes"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "boxes",
        "port": "out"
      },
      "to": {
        "node": "choose"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "choose",
        "port": "out"
      },
      "to": {
        "node": "consent"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "consent",
        "port": "out"
      },
      "to": {
        "node": "judge"
      }
    }
  ]
}
