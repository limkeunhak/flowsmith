    {
      "id": "sw30",
      "type": "custom",
      "name": "30Days 누르고 조회 보기",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "code": "const asked = []; const on = (r) => { const u = new URL(r.url()); if (u.pathname.includes('/ranking/')) asked.push(u.search); };\npage.on('request', on);\nawait page.locator('button[role=option]').filter({ hasText: /^30Days$/ }).first().click();\nawait page.waitForLoadState('networkidle', { timeout: 3000 }).catch(() => {}); await page.waitForTimeout(3500); page.off('request', on);\nconst hit = (t) => asked.some((s) => s.includes('type=' + t) && s.includes('duration=30'));\nreturn { asked: asked.join(' | ') || '요청 없음', equipment: hit('equipment'), decoration: hit('decoration') };",
        "outputs": [
          "asked",
          "equipment",
          "decoration"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
