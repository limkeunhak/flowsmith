{
  "schemaVersion": 1,
  "id": "trade-p2p-cancel",
  "name": "거래 · 정리 — 팔리지 않은 매물 내리기",
  "description": "03-p2p-trade-flow finally: 우리가 올렸고 팔리지 않았으면 Cancel Listing → Yes(지갑 없이 서버에서) → 사라질 때까지 다시 열기. 팔렸으면 그대로(다음 실행이 반대로 돈다)",
  "params": [
    {
      "name": "wallet",
      "label": "지갑",
      "required": true,
      "type": "select",
      "options": [
        "msu_qa_wallet_a",
        "msu_qa_wallet_b"
      ],
      "default": "msu_qa_wallet_a",
      "help": "이 실행이 쓸 지갑(시크릿) — 지휘 워크플로우가 역할에 따라 고른다"
    },
    {
      "name": "kind",
      "label": "자산 종류",
      "required": true,
      "type": "select",
      "options": [
        "nft",
        "character"
      ],
      "default": "nft",
      "help": "상세 경로 /marketplace/<kind>/<tokenId>"
    },
    {
      "name": "tokenId",
      "label": "토큰 id",
      "required": true,
      "type": "text",
      "options": [],
      "default": "",
      "help": ""
    },
    {
      "name": "created",
      "label": "우리가 올림",
      "required": true,
      "type": "text",
      "options": [],
      "default": "false",
      "help": ""
    },
    {
      "name": "sold",
      "label": "팔림",
      "required": true,
      "type": "text",
      "options": [],
      "default": "false",
      "help": ""
    }
  ],
  "vars": {},
  "secrets": [
    {
      "name": "msu_qa_wallet_a",
      "kind": "text",
      "shared": true,
      "description": "MSU QA 테스트 지갑 — 복구 문구 또는 개인키(QA 체인 전용) · 팀 공용 값에 넣는다"
    },
    {
      "name": "msu_qa_wallet_b",
      "kind": "text",
      "shared": true,
      "description": "MSU QA 테스트 지갑 — 복구 문구 또는 개인키(QA 체인 전용) · 팀 공용 값에 넣는다"
    }
  ],
  "settings": {
    "defaultTimeoutMs": 20000,
    "forbiddenLabels": [],
    "browser": "wallet",
    "wallet": {
      "mode": "metamask",
      "secret": "{{ $params.wallet }}",
      "announceAs": "MetaMask",
      "defaultChainId": 807424,
      "chains": [
        {
          "chainId": 807424,
          "name": "MSUQA",
          "rpcUrl": "https://qa-testnet-rpc.msu.io",
          "allowTx": true,
          "symbol": "NXPC"
        }
      ]
    }
  },
  "nodes": [
    {
      "id": "need",
      "type": "condition",
      "name": "내릴 것이 있나",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "cases": [
          {
            "id": "stop",
            "label": "내릴 매물이 없습니다(팔렸거나 우리가 올리지 않음)",
            "match": "any",
            "rules": [
              {
                "left": "{{ $params.created }}",
                "op": "ne",
                "right": "true"
              },
              {
                "left": "{{ $params.sold }}",
                "op": "eq",
                "right": "true"
              }
            ],
            "then": {
              "kind": "end",
              "status": "success",
              "message": "내릴 매물이 없습니다(팔렸거나 우리가 올리지 않음)"
            }
          }
        ],
        "else": {
          "then": {
            "kind": "next"
          }
        }
      }
    },
    {
      "id": "login",
      "type": "web",
      "name": "로그인(MetaMask)",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/marketplace"
        },
        "actions": [
          {
            "id": "a1063",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 5000
            }
          },
          {
            "id": "a1064",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1065",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "헤더의 Connect",
              "locators": [
                {
                  "kind": "css",
                  "value": "header button:has-text(\"Connect\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1066",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 1500
            }
          },
          {
            "id": "a1067",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "로그인 창의 «MetaMask Installed»",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//button[contains(.,\"MetaMask\") and contains(.,\"Installed\")])[1]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1068",
            "kind": "walletApprove",
            "risk": "safe",
            "timeoutMs": 120000,
            "optional": false,
            "done": {
              "kind": "hidden",
              "target": {
                "label": "헤더의 Connect",
                "locators": [
                  {
                    "kind": "css",
                    "value": "header button:has-text(\"Connect\")"
                  }
                ],
                "fingerprint": null,
                "frames": [],
                "verifiedAt": null
              }
            }
          }
        ]
      }
    },
    {
      "id": "cancel",
      "type": "web",
      "name": "판매 내리기",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/marketplace/{{ $params.kind }}/{{ $params.tokenId }}"
        },
        "actions": [
          {
            "id": "a1069",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 5000
            }
          },
          {
            "id": "a1070",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1071",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "Cancel Listing",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Cancel Listing\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1072",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "Yes",
              "locators": [
                {
                  "kind": "role",
                  "value": "button",
                  "name": "Yes"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1073",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": 90000,
            "optional": false,
            "wait": {
              "kind": "hidden",
              "target": {
                "label": "Cancel Listing",
                "locators": [
                  {
                    "kind": "css",
                    "value": "button:has-text(\"Cancel Listing\")"
                  }
                ],
                "fingerprint": null,
                "frames": [],
                "verifiedAt": null
              },
              "reloadEveryMs": 5000
            }
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "need",
        "port": "else"
      },
      "to": {
        "node": "login"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "login",
        "port": "out"
      },
      "to": {
        "node": "cancel"
      }
    }
  ]
}
