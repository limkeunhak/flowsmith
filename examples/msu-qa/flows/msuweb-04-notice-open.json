    {
      "id": "judge",
      "type": "check",
      "name": "판정",
      "position": {
        "x": 1500,
        "y": 0
      },
      "config": {
        "items": [
          {
            "id": "k134",
            "label": "고른 공지의 상세로 갔다",
            "actual": "{{ $node.atDetail.path }}",
            "op": "eq",
            "expected": "{{ $node.open.href }}"
          },
          {
            "id": "k135",
            "label": "목록에서 고른 글이 열려야 한다",
            "actual": "{{ $node.detail.body }}",
            "op": "contains",
            "expected": "{{ $node.open.title }}"
          },
          {
            "id": "k136",
            "label": "«TypeError»가 노출되지 않는다",
            "actual": "{{ $node.detail.body }}",
            "op": "notContains",
            "expected": "TypeError"
          },
          {
            "id": "k137",
            "label": "«ReferenceError»가 노출되지 않는다",
            "actual": "{{ $node.detail.body }}",
            "op": "notContains",
            "expected": "ReferenceError"
          },
          {
            "id": "k138",
            "label": "«at Object.»가 노출되지 않는다",
            "actual": "{{ $node.detail.body }}",
            "op": "notContains",
            "expected": "at Object."
          },
          {
            "id": "k139",
            "label": "«ECONNREFUSED»가 노출되지 않는다",
            "actual": "{{ $node.detail.body }}",
            "op": "notContains",
            "expected": "ECONNREFUSED"
          },
          {
            "id": "k140",
            "label": "«ETIMEDOUT»가 노출되지 않는다",
            "actual": "{{ $node.detail.body }}",
            "op": "notContains",
            "expected": "ETIMEDOUT"
          },
          {
            "id": "k141",
            "label": "«Internal Server»가 노출되지 않는다",
            "actual": "{{ $node.detail.body }}",
            "op": "notContains",
            "expected": "Internal Server"
          },
          {
            "id": "k142",
            "label": "«stacktrace»가 노출되지 않는다",
            "actual": "{{ $node.detail.body }}",
            "op": "notContains",
            "expected": "stacktrace"
          },
          {
            "id": "k143",
            "label": "«Traceback»가 노출되지 않는다",
            "actual": "{{ $node.detail.body }}",
            "op": "notContains",
            "expected": "Traceback"
          },
          {
            "id": "k144",
            "label": "목록 경로로 돌아왔다",
            "actual": "{{ $node.atList.path }}",
            "op": "eq",
            "expected": "/notices"
          },
          {
            "id": "k145",
            "label": "목록으로 돌아와야 한다",
            "actual": "{{ $node.back.again }}",
            "op": "startsWith",
            "expected": "/notices/"
          }
        ]
      }
    }
