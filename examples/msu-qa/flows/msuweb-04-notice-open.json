{
  "schemaVersion": 1,
  "id": "msuweb-04-notice-open",
  "name": "MSU 웹 · 공지 열기 → 목록으로",
  "description": "04-notices: 목록에서 첫 공지를 열면 같은 글의 상세가 열리고 Back to List 로 목록에 돌아온다",
  "params": [],
  "vars": {},
  "secrets": [],
  "settings": {
    "defaultTimeoutMs": 20000,
    "forbiddenLabels": []
  },
  "nodes": [
    {
      "id": "open",
      "type": "web",
      "name": "/notices 열기",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/notices"
        },
        "actions": [
          {
            "id": "a120",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 4000
            }
          },
          {
            "id": "a121",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a122",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "첫 공지",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//a[starts-with(@href,\"/notices/\")])[1]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "href",
            "strategy": "attribute",
            "attribute": "href",
            "transform": null
          },
          {
            "id": "a123",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "첫 공지 제목",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//a[starts-with(@href,\"/notices/\")])[1]//h4"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "title",
            "strategy": "innerText",
            "attribute": null,
            "transform": null
          }
        ]
      }
    },
    {
      "id": "detail",
      "type": "web",
      "name": "첫 공지 열기",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "continue"
        },
        "actions": [
          {
            "id": "a124",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a125",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "첫 공지",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//a[starts-with(@href,\"/notices/\")])[1]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a126",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": 20000,
            "optional": false,
            "wait": {
              "kind": "url",
              "pattern": "/notices/[^/?]+"
            }
          },
          {
            "id": "a127",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 3000
            }
          },
          {
            "id": "a128",
            "kind": "read",
            "risk": "safe",
