{
  "schemaVersion": 1,
  "id": "navigator-ranking-period",
  "name": "Navigator · 랭킹 기간 필터",
  "description": "01-explorer-landing: 랭킹 섹션의 기간 필터를 전환하면 선택 상태가 옮겨간다",
  "params": [],
  "vars": {},
  "secrets": [],
  "settings": {
    "defaultTimeoutMs": 20000,
    "forbiddenLabels": []
  },
  "nodes": [
    {
      "id": "open",
      "type": "web",
      "name": "기간 바꾸기",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/navigator"
        },
        "actions": [
          {
            "id": "a993",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 5000
            }
          },
          {
            "id": "a994",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a995",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "기간 «7Days»",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "//button[normalize-space(.)=\"7Days\"]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "before7",
            "strategy": "attribute",
            "attribute": "aria-selected",
            "transform": null
          },
          {
            "id": "a996",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "Highest Price",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//*[contains(normalize-space(.),\"Highest Price\") and not(*)])[1]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "ranking",
            "strategy": "innerText",
            "attribute": null,
            "transform": null
          },
          {
            "id": "a997",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "기간 «30Days»",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "//button[normalize-space(.)=\"30Days\"]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a998",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 2500
            }
          },
          {
            "id": "a999",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "기간 «30Days»",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "//button[normalize-space(.)=\"30Days\"]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "after30",
            "strategy": "attribute",
            "attribute": "aria-selected",
            "transform": null
          },
          {
            "id": "a1000",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "기간 «7Days»",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "//button[normalize-space(.)=\"7Days\"]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "after7",
            "strategy": "attribute",
            "attribute": "aria-selected",
            "transform": null
          }
        ]
      }
    },
    {
      "id": "judge",
      "type": "check",
      "name": "판정",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "items": [
          {
            "id": "k1001",
            "label": "기본 선택은 7Days",
            "actual": "{{ $input.before7 }}",
            "op": "eq",
            "expected": "true"
          },
          {
            "id": "k1002",
            "label": "랭킹 섹션이 있다",
            "actual": "{{ $input.ranking }}",
            "op": "notEmpty",
            "expected": null
          },
          {
            "id": "k1003",
            "label": "30Days를 누르면 30Days가 선택",
            "actual": "{{ $input.after30 }}",
            "op": "eq",
            "expected": "true"
          },
          {
            "id": "k1004",
            "label": "7Days는 선택이 풀린다",
            "actual": "{{ $input.after7 }}",
            "op": "eq",
            "expected": "false"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "open",
        "port": "out"
      },
      "to": {
        "node": "judge"
      }
    }
  ]
}
