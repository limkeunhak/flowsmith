{
  "schemaVersion": 1,
  "id": "msuweb-05-analytics-blocked",
  "name": "MSU 웹 · 분석 스크립트가 막혀도 동작한다",
  "description": "05-content-failure: GTM · GA · Segment · Sentry 요청을 모두 끊고 메인 → GNB Notices",
  "params": [],
  "vars": {},
  "secrets": [],
  "settings": {
    "defaultTimeoutMs": 20000,
    "forbiddenLabels": []
  },
  "nodes": [
    {
      "id": "route",
      "type": "custom",
      "name": "분석 스크립트 끊고 열기",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "code": "for (const p of [\"**://*.googletagmanager.com/**\",\"**://*.google-analytics.com/**\",\"**://*.segment.com/**\",\"**://*.segment.io/**\",\"**://*.sentry.io/**\"]) await page.route(p, (route) => route.abort());\nawait page.goto('https://qa.msu.io/', { waitUntil: 'domcontentloaded' });\nreturn { opened: page.url() };",
        "outputs": [
          "opened"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
    {
      "id": "open",
      "type": "web",
      "name": "메인 → Notices",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "continue"
        },
        "actions": [
          {
            "id": "a232",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 4000
            }
          },
          {
            "id": "a233",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a234",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "헤더",
              "locators": [
                {
                  "kind": "css",
                  "value": "header"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "header",
            "strategy": "innerText",
            "attribute": null,
            "transform": null
          },
          {
            "id": "a235",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "헤더의 Connect",
              "locators": [
                {
                  "kind": "css",
                  "value": "header button:has-text(\"Connect\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "connect",
            "strategy": "innerText",
            "attribute": null,
            "transform": null
          },
          {
            "id": "a236",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "GNB «Notices»",
              "locators": [
                {
                  "kind": "css",
                  "value": "header a[data-link=\"gnb-link\"]:has-text(\"Notices\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a237",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": 15000,
            "optional": false,
            "wait": {
              "kind": "url",
              "pattern": "/notices(\\?|$)"
            }
          }
        ]
      }
    },
    {
      "id": "measure",
      "type": "custom",
      "name": "공지 수 · 가로 넘침",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "code": "await page.locator('a[href^=\"/notices/\"]').first().waitFor({ state: 'visible', timeout: 15000 }).catch(() => {});\nconst noticeCount = await page.locator('a[href^=\"/notices/\"]').count();\nconst overflow = await page.evaluate(() => document.documentElement.scrollWidth - window.innerWidth > 2);\nconst body = await page.locator('body').innerText().catch(() => '');\nreturn { noticeCount, overflow, body };",
        "outputs": [
          "noticeCount",
          "overflow",
          "body"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
    {
      "id": "judge",
      "type": "check",
      "name": "판정",
      "position": {
        "x": 900,
        "y": 0
      },
      "config": {
        "items": [
          {
            "id": "k238",
            "label": "헤더가 있어야 한다",
            "actual": "{{ $node.open.header }}",
            "op": "notEmpty",
            "expected": null
          },
          {
            "id": "k239",
            "label": "로그인 진입점은 살아 있어야 한다",
            "actual": "{{ $node.open.connect }}",
            "op": "contains",
            "expected": "Connect"
          },
          {
            "id": "k240",
            "label": "이동한 화면도 정상이어야 한다",
            "actual": "{{ $input.noticeCount }}",
            "op": "gt",
            "expected": "0"
          },
          {
            "id": "k241",
            "label": "«TypeError»가 노출되지 않는다",
            "actual": "{{ $input.body }}",
            "op": "notContains",
            "expected": "TypeError"
          },
          {
            "id": "k242",
            "label": "«ReferenceError»가 노출되지 않는다",
            "actual": "{{ $input.body }}",
            "op": "notContains",
            "expected": "ReferenceError"
          },
          {
            "id": "k243",
            "label": "«at Object.»가 노출되지 않는다",
            "actual": "{{ $input.body }}",
            "op": "notContains",
            "expected": "at Object."
          },
          {
            "id": "k244",
            "label": "«ECONNREFUSED»가 노출되지 않는다",
            "actual": "{{ $input.body }}",
            "op": "notContains",
            "expected": "ECONNREFUSED"
          },
          {
            "id": "k245",
            "label": "«ETIMEDOUT»가 노출되지 않는다",
            "actual": "{{ $input.body }}",
            "op": "notContains",
            "expected": "ETIMEDOUT"
          },
          {
            "id": "k246",
            "label": "«Internal Server»가 노출되지 않는다",
            "actual": "{{ $input.body }}",
            "op": "notContains",
            "expected": "Internal Server"
          },
          {
            "id": "k247",
            "label": "«stacktrace»가 노출되지 않는다",
            "actual": "{{ $input.body }}",
            "op": "notContains",
            "expected": "stacktrace"
          },
          {
            "id": "k248",
            "label": "«Traceback»가 노출되지 않는다",
            "actual": "{{ $input.body }}",
            "op": "notContains",
            "expected": "Traceback"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "route",
        "port": "out"
      },
      "to": {
        "node": "open"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "open",
        "port": "out"
      },
      "to": {
        "node": "measure"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "measure",
        "port": "out"
      },
      "to": {
        "node": "judge"
      }
    }
  ]
}
