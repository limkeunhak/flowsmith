{
  "schemaVersion": 1,
  "id": "navigator-12-nickname-activity",
  "name": "Navigator · 닉네임 상세 발행 · 거래 내역",
  "description": "12-nickname-detail: 닉네임 상세에 Price · From · To · Date 열의 표가 있고 Mint 기록이 있다",
  "params": [
    {
      "name": "owner",
      "label": "닉네임을 가진 지갑",
      "required": true,
      "type": "text",
      "options": [],
      "default": "0x18B8958F05263D89281f1bdd97AFfc5879394292",
      "help": "QA — 캐릭터 43개 · 닉네임 evaans"
    }
  ],
  "vars": {},
  "secrets": [],
  "settings": {
    "defaultTimeoutMs": 20000,
    "forbiddenLabels": []
  },
  "nodes": [
