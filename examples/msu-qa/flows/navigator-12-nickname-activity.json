    {
      "id": "judge",
      "type": "check",
      "name": "판정",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "items": [
          {
            "id": "k912",
            "label": "닉네임 상세가 열려야 한다",
            "actual": "{{ $input.notFound }}",
            "op": "empty",
            "expected": null
          },
          {
            "id": "k913",
            "label": "Price 열이 있어야 한다",
            "actual": "{{ $input.heads }}",
            "op": "anyEq",
            "expected": "Price"
          },
          {
            "id": "k914",
            "label": "From 열이 있어야 한다",
            "actual": "{{ $input.heads }}",
            "op": "anyEq",
            "expected": "From"
          },
          {
            "id": "k915",
            "label": "To 열이 있어야 한다",
            "actual": "{{ $input.heads }}",
            "op": "anyEq",
            "expected": "To"
          },
          {
            "id": "k916",
            "label": "Date 열이 있어야 한다",
            "actual": "{{ $input.heads }}",
            "op": "anyEq",
            "expected": "Date"
          },
          {
            "id": "k917",
            "label": "발행 내역이라도 있어야 한다",
            "actual": "{{ $input.rows }}",
            "op": "countGte",
            "expected": "1"
          },
          {
            "id": "k918",
            "label": "Mint 기록이 있어야 한다",
            "actual": "{{ $input.rows }}",
            "op": "anyEq",
            "expected": "Mint"
          }
        ]
