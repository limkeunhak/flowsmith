                  "name": "c3",
                  "selector": "th:nth-child(3)",
                  "strategy": "innerText"
                },
                {
                  "name": "c4",
                  "selector": "th:nth-child(4)",
                  "strategy": "innerText"
                },
                {
                  "name": "c5",
                  "selector": "th:nth-child(5)",
                  "strategy": "innerText"
                },
                {
                  "name": "c6",
                  "selector": "th:nth-child(6)",
                  "strategy": "innerText"
