            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "첫 닉네임 링크",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//a[contains(@href,\"/navigator/nickname/\")])[1]"
