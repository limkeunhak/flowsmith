      "config": {
        "code": "await page.setViewportSize({ width: Number(390), height: Number(844) });\nawait page.reload({ waitUntil: 'domcontentloaded' }); await page.waitForTimeout(4000);\nreturn { visible: await page.locator('header a[data-link=\"gnb-link\"]').evaluateAll((els) => els.filter((e) => e.offsetParent).length) };",
        "outputs": [
          "visible"
        ],
        "usesPage": true,
        "timeoutMs": 60000
