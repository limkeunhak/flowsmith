            "id": "k502",
            "label": "검색어가 URL에 실린다",
            "actual": "{{ $node.kw.keyword }}",
            "op": "eq",
            "expected": "{{ $node.prep.term }}"
          },
          {
            "id": "k503",
            "label": "키워드 검색은 조회 요청을 보낸다",
            "actual": "{{ $node.kw.callCount }}",
            "op": "gt",
            "expected": "0"
          },
          {
            "id": "k504",
            "label": "조회 요청에 검색어가 담긴다",
            "actual": "{{ $node.kw.lastBody }}",
            "op": "contains",
            "expected": "{{ $node.prep.term }}"
          },
