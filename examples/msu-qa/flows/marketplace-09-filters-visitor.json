      "position": {
        "x": 1500,
        "y": 0
      },
      "config": {
        "code": "const cards = await page.evaluate(() => { const m = new Map();\n  for (const el of document.querySelectorAll('[data-gtm-target=\"nft_card\"][data-gtm-token-id]')) { const id = el.getAttribute('data-gtm-token-id'); const n = el.getAttribute('data-gtm-item-name'); if (id && n) m.set(id, n); }\n  return { names: [...m.values()], ids: [...new Set([...document.querySelectorAll('article[data-gtm-target=\"nft_card\"][data-gtm-token-id]')].map((e) => e.getAttribute('data-gtm-token-id')))] }; });\npage.__explore = [];\nif (!page.__exploreOn) { page.__exploreOn = true; page.on('request', (r) => { if (/\\/api\\/marketplace\\/explore\\/items$/.test(r.url())) page.__explore.push(r.postData() || ''); }); }\nreturn { url: page.url(), cards: cards.ids.length };",
        "outputs": [
