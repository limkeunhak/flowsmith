      "type": "web",
      "name": "NFT 목록",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/marketplace/nft"
        },
        "actions": [
          {
            "id": "a489",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 6000
            }
          },
          {
            "id": "a490",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a491",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "첫 카드 이름",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//*[@data-gtm-target=\"nft_card\" and @data-gtm-token-id and @data-gtm-item-name])[1]"
