            "actual": "{{ $node.kw.strays }}",
            "op": "countEq",
            "expected": "0"
          },
          {
            "id": "k506",
            "label": "결과가 있거나, 없으면 없다고 말한다",
            "actual": "{{ $node.kw.firstHit }}{{ $node.kw.notice }}",
            "op": "notEmpty",
            "expected": null
          },
          {
            "id": "k507",
            "label": "비회원의 필터 Search는 조회 요청을 보내지 않는다",
            "actual": "{{ $node.after.callCount }}",
            "op": "eq",
            "expected": "0"
          },
          {
            "id": "k508",
            "label": "비회원의 필터 Search는 URL을 바꾸지 않는다",
            "actual": "{{ $node.after.url }}",
            "op": "eq",
            "expected": "{{ $node.before.url }}"
          },
          {
            "id": "k509",
            "label": "목록도 그대로다(카드 수)",
            "actual": "{{ $node.after.cards }}",
            "op": "eq",
            "expected": "{{ $node.before.cards }}"
          },
          {
            "id": "k510",
            "label": "로그인 창을 띄우지도 않는다(현재 동작)",
