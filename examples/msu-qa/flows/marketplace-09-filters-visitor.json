    {
      "id": "prep",
      "type": "custom",
      "name": "로그인 상태 · 검색어 · 요청 듣기",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "code": "const raw = await page.evaluate(() => localStorage.getItem('msu_auth_store'));\nlet isLogin = false; try { isLogin = JSON.parse(raw)?.state?.isLogin === true; } catch {}\npage.__explore = [];\nif (!page.__exploreOn) { page.__exploreOn = true; page.on('request', (r) => { if (/\\/api\\/marketplace\\/explore\\/items$/.test(r.url())) page.__explore.push(r.postData() || ''); }); }\nreturn { isLogin, term: String(input.firstName || 'AbsoLab Piercing Spear').split('#')[0].trim() };",
        "outputs": [
          "isLogin",
          "term"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
    {
      "id": "search",
      "type": "web",
      "name": "키워드 검색",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "continue"
        },
        "actions": [
          {
            "id": "a492",
            "kind": "fill",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "목록 검색 칸(keyword)",
              "locators": [
                {
                  "kind": "css",
                  "value": "input[name=\"keyword\"]:visible >> nth=0"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "value": "{{ $input.term }}"
          },
          {
            "id": "a493",
            "kind": "press",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "목록 검색 칸(keyword)",
              "locators": [
                {
                  "kind": "css",
                  "value": "input[name=\"keyword\"]:visible >> nth=0"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "key": "Enter"
          },
          {
            "id": "a494",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 5000
            }
          }
        ]
      }
    },
    {
      "id": "kw",
      "type": "custom",
      "name": "키워드 검색 결과 · 나간 요청",
      "position": {
        "x": 900,
        "y": 0
      },
      "config": {
        "code": "const calls = page.__explore.splice(0);\nconst cards = await page.evaluate(() => { const m = new Map();\n  for (const el of document.querySelectorAll('[data-gtm-target=\"nft_card\"][data-gtm-token-id]')) { const id = el.getAttribute('data-gtm-token-id'); const n = el.getAttribute('data-gtm-item-name'); if (id && n) m.set(id, n); }\n  return { names: [...m.values()], ids: [...new Set([...document.querySelectorAll('article[data-gtm-target=\"nft_card\"][data-gtm-token-id]')].map((e) => e.getAttribute('data-gtm-token-id')))] }; });\nconst t = String(input.term).toLowerCase();\nconst notice = cards.names.length ? '' : await page.locator('text=/No (search )?results|There are no .* yet/i').first().waitFor({ state: 'visible', timeout: 10000 }).then(() => '없음 안내', () => '');\nreturn { notice, keyword: new URL(page.url()).searchParams.get('keyword') ?? '', callCount: calls.length, lastBody: calls[calls.length - 1] ?? '',\n  hits: cards.names, firstHit: cards.names[0] ?? '', strays: cards.names.filter((n) => !n.toLowerCase().includes(t)) };",
        "outputs": [
          "keyword",
          "callCount",
          "lastBody",
          "hits",
          "firstHit",
          "strays",
          "notice"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
    {
      "id": "reopen",
      "type": "web",
      "name": "NFT 목록 다시",
      "position": {
        "x": 1200,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "continue"
        },
        "actions": [
          {
            "id": "a495",
            "kind": "goto",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "url": "https://qa.msu.io/marketplace/nft"
          },
          {
            "id": "a496",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
