{
  "schemaVersion": 1,
  "id": "navigator-14-mobile-search",
  "name": "Navigator · 모바일 검색 → 상세",
  "description": "14-responsive: 390×844 에서도 보이는 검색 칸으로 검색해 상세에 도달하고 404가 아니다 — 검색어는 실행 입력",
  "params": [
    {
      "name": "width",
      "label": "가로(px)",
      "required": true,
      "type": "text",
      "options": [],
      "default": "390",
      "help": ""
    },
    {
      "name": "height",
      "label": "세로(px)",
      "required": true,
      "type": "text",
      "options": [],
      "default": "844",
      "help": ""
    },
    {
      "name": "name",
      "label": "검색할 캐릭터 이름",
      "required": true,
      "type": "text",
      "options": [],
      "default": "blahh",
      "help": ""
    }
  ],
  "vars": {},
  "secrets": [],
  "settings": {
    "defaultTimeoutMs": 20000,
    "forbiddenLabels": []
  },
  "nodes": [
    {
      "id": "open",
      "type": "web",
      "name": "Navigator 열기",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/navigator"
        },
        "actions": [
          {
            "id": "a968",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 1000
            }
          }
        ]
      }
    },
    {
      "id": "viewport",
      "type": "custom",
      "name": "화면 크기",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "code": "await page.setViewportSize({ width: Number(ctx.params.width), height: Number(ctx.params.height) });\nawait page.reload({ waitUntil: 'domcontentloaded' });\nreturn { size: page.viewportSize() };",
        "outputs": [
          "size"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
    {
      "id": "search",
      "type": "web",
      "name": "검색",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "continue"
        },
        "actions": [
          {
            "id": "a969",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 5000
            }
          },
          {
            "id": "a970",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a971",
            "kind": "fill",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "보이는 검색 칸",
              "locators": [
                {
                  "kind": "css",
                  "value": ":nth-match(input[placeholder*=\"Item/Character Name\" i]:visible, 1)"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "value": "{{ $params.name }}"
          },
          {
            "id": "a972",
            "kind": "press",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "보이는 검색 칸",
              "locators": [
                {
                  "kind": "css",
                  "value": ":nth-match(input[placeholder*=\"Item/Character Name\" i]:visible, 1)"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "key": "Enter"
          },
          {
            "id": "a973",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": 15000,
            "optional": false,
            "wait": {
              "kind": "url",
              "pattern": "/navigator/(nickname|character|nft|owner)/"
            }
          },
          {
            "id": "a974",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 3000
            }
          },
          {
            "id": "a975",
            "kind": "read",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "«Page Not Found»",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//*[normalize-space(text())=\"Page Not Found\"])[1]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "output": "notFound",
            "strategy": "innerText",
            "attribute": null,
            "transform": null
          }
        ]
      }
    },
    {
      "id": "where",
      "type": "custom",
      "name": "지금 주소",
      "position": {
        "x": 900,
        "y": 0
      },
      "config": {
        "code": "return { path: new URL(page.url()).pathname, url: decodeURIComponent(page.url()), title: await page.title() };",
        "outputs": [
          "path",
          "url",
          "title"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
    {
      "id": "judge",
      "type": "check",
      "name": "판정",
      "position": {
        "x": 1200,
        "y": 0
      },
      "config": {
        "items": [
          {
            "id": "k976",
            "label": "검색으로 상세 페이지에 도달해야 한다",
            "actual": "{{ $input.url }}",
            "op": "matches",
            "expected": "/navigator/(character|nft|nickname|owner)/"
          },
          {
            "id": "k977",
            "label": "검색 결과가 404 면 안 된다",
            "actual": "{{ $node.search.notFound }}",
            "op": "empty",
            "expected": null
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "open",
        "port": "out"
      },
      "to": {
        "node": "viewport"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "viewport",
        "port": "out"
      },
      "to": {
        "node": "search"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "search",
        "port": "out"
      },
      "to": {
        "node": "where"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "where",
        "port": "out"
      },
      "to": {
        "node": "judge"
      }
    }
  ]
}
