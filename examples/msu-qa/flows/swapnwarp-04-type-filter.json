    {
      "id": "s_NXPC_TO_NESO",
      "type": "custom",
      "name": "NXPC_TO_NESO 결과 — URL · 요청 · 응답 · 화면",
      "position": {
        "x": 1500,
        "y": 0
      },
      "config": {
        "code": "const until = Date.now() + 15000;\nwhile (!page.__tx.length && Date.now() < until) await page.waitForTimeout(300);\nconst got = page.__tx.splice(0); const last = got[got.length - 1] ?? { url: '', entries: [] };\nconst req = last.url ? new URL(last.url).searchParams : new URLSearchParams();\nconst here = new URL(page.url()).searchParams;\nconst notice = await page.locator('[role=\"status\"][aria-label^=\"No transaction items found\"]').first().isVisible().catch(() => false);\nconst tableCount = await page.locator('#swap_table').count();\nconst rows = await page.locator('#swap_table [role=\"row\"][aria-label^=\"Swap transaction row for\"]').evaluateAll((els) => els.map((row) => {\n  const cells = [...row.querySelectorAll('[role=\"cell\"]')].map((c) => (c.innerText || '').replace(/\\s+/g, ' ').trim());\n  const a = (cells[1] || '').match(/[\\d,]+(?:\\.\\d+)?/g) || [];\n  return { address: (row.getAttribute('aria-label') || '').replace('Swap transaction row for ', ''), pay: a[0] || '', receive: a[1] || '' }; }));\nconst want = 'SWAP_TYPE_NXPC_TO_NESO'; const num = (v) => Number(String(v).replace(/,/g, ''));\nreturn { transactionType: here.get('transactionType') ?? '', swapType: req.get('swapType') ?? '',\n  others: [...new Set(last.entries.filter((e) => e.swapType !== want).map((e) => e.swapType))],\n  respHas: last.entries.length > 0, shownHas: rows.length > 0,\n  wrongWay: rows.filter((r) => num(r.receive) <= num(r.pay)).map((r) => r.pay + '→' + r.receive),\n  rowsOrNotice: rows.length ? rows.length + '행' : notice ? '없음 안내' : '' };",
        "outputs": [
          "transactionType",
          "swapType",
          "others",
          "respHas",
          "shownHas",
          "wrongWay",
          "rowsOrNotice"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
