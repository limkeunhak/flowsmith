        "x": 300,
        "y": 0
      },
      "config": {
        "code": "page.__tx = [];\nif (!page.__txOn) { page.__txOn = true; page.on('response', async (r) => { if (!/\\/swapnwarp\\/api\\/swap\\/transaction\\?/.test(r.url())) return;\n  let entries = []; try { entries = (await r.json()).transactions ?? []; } catch {} page.__tx.push({ url: r.url(), entries }); }); }\nreturn { watching: true };",
        "outputs": [
          "watching"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
    },
