      "config": {
        "code": "const raw = await page.evaluate(() => localStorage.getItem('msu_auth_store'));\nlet isLogin = false; try { isLogin = JSON.parse(raw)?.state?.isLogin === true; } catch {}\nconst until = Date.now() + 15000;\nwhile (!page.__tx.length && Date.now() < until) await page.waitForTimeout(300);\nconst got = page.__tx.splice(0); const last = got[got.length - 1] ?? { url: '', entries: [] };\nconst req = last.url ? new URL(last.url).searchParams : new URLSearchParams();\nconst here = new URL(page.url()).searchParams;\nconst notice = await page.locator('[role=\"status\"][aria-label^=\"No transaction items found\"]').first().isVisible().catch(() => false);\nconst tableCount = await page.locator('#swap_table').count();\nreturn { isLogin, swapType: req.get('swapType') ?? '' };",
        "outputs": [
          "isLogin",
          "swapType"
        ],
        "usesPage": true,
        "timeoutMs": 60000
      }
