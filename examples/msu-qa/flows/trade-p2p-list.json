{
  "schemaVersion": 1,
  "id": "trade-p2p-list",
  "name": "거래 · 판매 등록 — 판매자 지갑",
  "description": "03-p2p-trade-flow 1/3: 상세에서 List for sale → 가격 → Confirm → MetaMask 승인(NFT 승인 · 등록 서명 — 몇 개든). 끝 표시는 «Cancel Listing»",
  "params": [
    {
      "name": "wallet",
      "label": "지갑",
      "required": true,
      "type": "select",
      "options": [
        "msu_qa_wallet_a",
        "msu_qa_wallet_b"
      ],
      "default": "msu_qa_wallet_a",
      "help": "이 실행이 쓸 지갑(시크릿) — 지휘 워크플로우가 역할에 따라 고른다"
    },
    {
      "name": "kind",
      "label": "자산 종류",
      "required": true,
      "type": "select",
      "options": [
        "nft",
        "character"
      ],
      "default": "nft",
      "help": "상세 경로 /marketplace/<kind>/<tokenId>"
    },
    {
      "name": "tokenId",
      "label": "토큰 id",
      "required": true,
      "type": "text",
      "options": [],
      "default": "",
      "help": ""
    },
    {
      "name": "price",
      "label": "가격(NESO)",
      "required": true,
      "type": "text",
      "options": [],
      "default": "1",
      "help": ""
    },
    {
      "name": "alreadyListed",
      "label": "이미 판매 중",
      "required": false,
      "type": "text",
      "options": [],
      "default": "false",
      "help": ""
    }
  ],
  "vars": {},
  "secrets": [
    {
      "name": "msu_qa_wallet_a",
      "kind": "text",
      "description": "MSU QA 테스트 지갑 — 복구 문구 또는 개인키(QA 체인 전용)"
    },
    {
      "name": "msu_qa_wallet_b",
      "kind": "text",
      "description": "MSU QA 테스트 지갑 — 복구 문구 또는 개인키(QA 체인 전용)"
    }
  ],
  "settings": {
    "defaultTimeoutMs": 20000,
    "forbiddenLabels": [],
    "browser": "wallet",
    "wallet": {
      "mode": "metamask",
      "secret": "{{ $params.wallet }}",
      "announceAs": "MetaMask",
      "defaultChainId": 807424,
      "chains": [
        {
          "chainId": 807424,
          "name": "MSU QA",
          "rpcUrl": "",
          "allowTx": false
        }
      ]
    }
  },
  "nodes": [
    {
      "id": "resume",
      "type": "condition",
      "name": "앞 실행의 매물?",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "cases": [
          {
            "id": "stop",
            "label": "앞 실행이 남긴 판매 중 매물을 이어 씁니다",
            "match": "any",
            "rules": [
              {
                "left": "{{ $params.alreadyListed }}",
                "op": "eq",
                "right": "true"
              }
            ],
            "then": {
              "kind": "end",
              "status": "success",
              "message": "앞 실행이 남긴 판매 중 매물을 이어 씁니다"
            }
          }
        ],
        "else": {
          "then": {
            "kind": "next"
          }
        }
      }
    },
    {
      "id": "login",
      "type": "web",
      "name": "로그인(MetaMask)",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/marketplace"
        },
        "actions": [
          {
            "id": "a1035",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 5000
            }
          },
          {
            "id": "a1036",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1037",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "헤더의 Connect",
              "locators": [
                {
                  "kind": "css",
                  "value": "header button:has-text(\"Connect\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1038",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 1500
            }
          },
          {
            "id": "a1039",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "로그인 창의 «MetaMask Installed»",
              "locators": [
                {
                  "kind": "xpath",
                  "value": "(//button[contains(.,\"MetaMask\") and contains(.,\"Installed\")])[1]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1040",
            "kind": "walletApprove",
            "risk": "safe",
            "timeoutMs": 120000,
            "optional": false,
            "done": {
              "kind": "hidden",
              "target": {
                "label": "헤더의 Connect",
                "locators": [
                  {
                    "kind": "css",
                    "value": "header button:has-text(\"Connect\")"
                  }
                ],
                "fingerprint": null,
                "frames": [],
                "verifiedAt": null
              }
            }
          }
        ]
      }
    },
    {
      "id": "list",
      "type": "web",
      "name": "판매 등록",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "start": {
          "kind": "url",
          "url": "https://qa.msu.io/marketplace/{{ $params.kind }}/{{ $params.tokenId }}"
        },
        "actions": [
          {
            "id": "a1041",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "wait": {
              "kind": "fixed",
              "ms": 5000
            }
          },
          {
            "id": "a1042",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": true,
            "target": {
              "label": "쿠키 «Accept All Cookies»",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Accept All Cookies\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1043",
            "kind": "wait",
            "risk": "safe",
            "timeoutMs": 30000,
            "optional": false,
            "wait": {
              "kind": "visible",
              "target": {
                "label": "List for sale",
                "locators": [
                  {
                    "kind": "css",
                    "value": "button:has-text(\"List for sale\")"
                  }
                ],
                "fingerprint": null,
                "frames": [],
                "verifiedAt": null
              }
            }
          },
          {
            "id": "a1044",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "List for sale",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"List for sale\")"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1045",
            "kind": "fill",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "가격 칸",
              "locators": [
                {
                  "kind": "css",
                  "value": "input[name=\"price\"]"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "value": "{{ $params.price }}"
          },
          {
            "id": "a1046",
            "kind": "click",
            "risk": "safe",
            "timeoutMs": null,
            "optional": false,
            "target": {
              "label": "Confirm",
              "locators": [
                {
                  "kind": "css",
                  "value": "button:has-text(\"Confirm\"):visible"
                }
              ],
              "fingerprint": null,
              "frames": [],
              "verifiedAt": null
            },
            "popup": false
          },
          {
            "id": "a1047",
            "kind": "walletApprove",
            "risk": "safe",
            "timeoutMs": 180000,
            "optional": false,
            "done": {
              "kind": "visible",
              "target": {
                "label": "Cancel Listing",
                "locators": [
                  {
                    "kind": "css",
                    "value": "button:has-text(\"Cancel Listing\")"
                  }
                ],
                "fingerprint": null,
                "frames": [],
                "verifiedAt": null
              }
            }
          }
        ]
      }
    },
    {
      "id": "at",
      "type": "custom",
      "name": "등록 시각",
      "position": {
        "x": 900,
        "y": 0
      },
      "config": {
        "code": "return { listedAt: String(Date.now()), created: 'true' };",
        "outputs": [
          "listedAt",
          "created"
        ],
        "usesPage": false,
        "timeoutMs": 60000
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "resume",
        "port": "else"
      },
      "to": {
        "node": "login"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "login",
        "port": "out"
      },
      "to": {
        "node": "list"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "list",
        "port": "out"
      },
      "to": {
        "node": "at"
      }
    }
  ]
}
